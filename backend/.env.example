# সার্ভার পোর্ট
PORT=4000

# এডমিন প্যানেলের টোকেন — admin.html লগইনে এটি ব্যবহার হবে
# REQUIRED in production (NODE_ENV=production): >=16 random chars; server refuses to start if unset/default.
# Sent only via the x-admin-token header; admin.html keeps it in sessionStorage.
# REQUIRED in production (NODE_ENV=production): >=16 random chars; server refuses to start if unset/default.
# Sent only via the x-admin-token header; admin.html keeps it in sessionStorage.
ADMIN_TOKEN=change-me-to-a-long-random-string

# ইমেইল ফরওয়ার্ডিং (ঐচ্ছিক)। এগুলো ফাঁকা রাখলে রিপোর্ট শুধু
# "queued_for_authority" স্ট্যাটাসে জমা থাকবে, কোনো ইমেইল পাঠানো হবে না।
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Comma-separated browser origins allowed by CORS, e.g. https://admin.example.com. Empty = same-origin only.
CORS_ORIGINS=
# Duplicate merge: a new report of the same road type within this radius/window returns the existing report (200, duplicate:true).
DUP_RADIUS_M=30
DUP_WINDOW_HOURS=24

# Reverse-proxy hops to trust for req.ip (rate limits, flag dedupe): integer 0-10, or loopback|linklocal|uniquelocal.
# Unset = don't trust X-Forwarded-For. Anything else makes the server refuse to start.
# IPv6 clients are keyed by their /64 prefix.
TRUST_PROXY=

# Reporter name/phone are erased from reports older than this many days (checked at start and daily).
CONTACT_RETENTION_DAYS=90
# Base URL used in authority digest emails (cron: `node scripts/manage.js digest`).
PUBLIC_URL=
# Admin/authority tokens expire this many days after creation or rotation (0 = never).
TOKEN_TTL_DAYS=180
